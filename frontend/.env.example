# --- Social sign-in ---------------------------------------------------------
# All optional — leave a line out and that provider's button/widget just
# doesn't render. These are public client identifiers, safe to ship in the
# built JS (never put a client *secret* here — those live in backend/.env
# only). Matching setup: backend/.env.example.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
VITE_GOOGLE_CLIENT_ID=

# GitHub -> Settings -> Developer settings -> OAuth Apps.
VITE_GITHUB_CLIENT_ID=

# The Telegram bot's public @username (not its token) — @BotFather.
VITE_TELEGRAM_BOT_USERNAME=
