# --- Database -------------------------------------------------------------
# async driver is used by the app, alembic swaps to psycopg-free asyncpg too
DATABASE_URL=postgresql+asyncpg://diagram:diagram@localhost:5432/diagram

# --- Azure OpenAI ---------------------------------------------------------
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5-mini
# Optional: cheaper deployment for prompt polishing / narration (defaults to the one above)
# AZURE_OPENAI_FAST_DEPLOYMENT=gpt-5-nano
# gpt-5 family only - set empty if the deployment is not a reasoning model
AZURE_OPENAI_REASONING_EFFORT=low

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=10080

# --- App ------------------------------------------------------------------
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
