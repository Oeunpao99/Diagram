# --- Database -------------------------------------------------------------
# async driver is used by the app, alembic swaps to psycopg-free asyncpg too
DATABASE_URL=postgresql+asyncpg://diagram:diagram@localhost:5432/diagram

# --- Azure OpenAI ---------------------------------------------------------
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5-mini
# Optional: cheaper deployment for prompt polishing / narration (defaults to the one above)
# AZURE_OPENAI_FAST_DEPLOYMENT=gpt-5-nano
# gpt-5 family only - set empty if the deployment is not a reasoning model
AZURE_OPENAI_REASONING_EFFORT=low

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=10080

# --- Social sign-in ---------------------------------------------------------
# All optional — leave a provider's lines out and its /auth/{provider} route
# just answers "not configured" instead of the app refusing to boot.
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add {your frontend origin}/auth/callback/google as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Set its "Authorization callback URL" to
# {your frontend origin}/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- App ------------------------------------------------------------------
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Credits & payment (Bakong KHQR) ----------------------------------------
# Optional: leave BAKONG_ACCOUNT_ID or BAKONG_API_TOKEN empty and the top-up
# dialog just says payments aren't switched on. Pack prices and AI costs live
# in app/services/credits.py.
SIGNUP_CREDITS=20
# The Bakong account that receives payments, e.g. yourname@aclb
BAKONG_ACCOUNT_ID=
# Leave these two EMPTY. When set, ABA and ACLEDA refuse to pay the QR (they
# try to route to that account number / bank instead of the Bakong id) —
# only Vattanac accepted it. Bakong id alone works in every bank app.
BAKONG_ACCOUNT_INFO=
BAKONG_ACQUIRING_BANK=
# Shown in the payer's banking app (max 25 / 15 characters)
BAKONG_MERCHANT_NAME=Kumnous
BAKONG_MERCHANT_CITY=Phnom Penh
# From https://api-bakong.nbc.gov.kh (register, then renew it every year)
BAKONG_API_TOKEN=
